#!/usr/bin/env python3
"""check-public-hygiene -- scan what will be world-readable.

  scripts/check-public-hygiene [--repo DIR]      scan EVERY blob and path reachable from any
                                                 ref (read from git, not from the disk), the
                                                 full commit metadata, ref names and tag text
  scripts/check-public-hygiene --stdin           scan text on stdin (a PR title or body)

Generic patterns come from scripts/deny-patterns (committed) plus one rule: any
e-mail address except the GitHub noreply forms (<id>+<user>@users.noreply.github.com
and exactly noreply@github.com). Project-specific patterns come from the untracked
file named by HYGIENE_EXTRA_PATTERNS_FILE (one regular expression per line,
case-insensitive; blank lines and lines starting with # are ignored).

Every commit and tag date must carry the +0000 offset (a local offset would publish the
author's time zone), except for commits whose committer e-mail is exactly
noreply@github.com (made by GitHub itself; the number skipped is printed). The repository scan refuses a dirty working tree (exit 2): it scans what will be
pushed, so commit first. Binary blobs are scanned too (bytes decoded as latin-1).
scripts/deny-patterns is exempt from the GENERIC patterns only (it holds their text);
the private patterns and the e-mail rule still apply to it.

Output never prints a matched value, only where it matched and how many times; a path
that matched is shown as a hash, a blob whose path matched by its object id.
Exit 0 clean, 1 findings, 2 usage, setup or dirty-tree error.
"""
import hashlib
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")
NOREPLY = re.compile(r"(?:@users\.noreply\.github\.com|^noreply@github\.com)$", re.I)
PATTERN_FILE = "scripts/deny-patterns"


def load_patterns():
    pats = []  # (label, compiled)
    with open(os.path.join(HERE, "deny-patterns")) as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            name, rx = line.split("\t", 1)
            pats.append((name, re.compile(rx)))
    extra = os.environ.get("HYGIENE_EXTRA_PATTERNS_FILE")
    n_extra = 0
    if extra:
        if not os.path.isfile(extra):
            print("hygiene: HYGIENE_EXTRA_PATTERNS_FILE is set but is not a file")
            sys.exit(2)
        with open(extra) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                try:
                    rx = re.compile(line, re.I)
                except re.error:
                    rx = re.compile(re.escape(line), re.I)
                n_extra += 1
                pats.append(("private-pattern-%d" % n_extra, rx))
    return pats, n_extra


def scan_text(label, text, pats, generic=True):
    found = []
    for name, rx in pats:
        if not generic and not name.startswith("private-pattern-"):
            continue
        c = sum(1 for _ in rx.finditer(text))
        if c:
            found.append((label, name, c))
    c = sum(1 for m in EMAIL.finditer(text) if not NOREPLY.search(m.group(0)))
    if c:
        found.append((label, "non-noreply-email", c))
    return found


def git(repo, *args, data=None):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, check=True, input=data).stdout


def scan_repo(repo, pats):
    findings, units, binaries = [], 0, 0
    if git(repo, "status", "--porcelain").strip():
        print("hygiene: working tree is dirty; commit or stash before the pre-push scan")
        sys.exit(2)
    # every object reachable from any ref, with the path it was found under
    paths = {}
    order = []
    for line in git(repo, "rev-list", "--all", "--objects").decode("utf-8", "replace").splitlines():
        sha, _, path = line.partition(" ")
        if sha not in paths:
            paths[sha] = set()
            order.append(sha)
        if path:
            paths[sha].add(path)
    flagged_paths = set()
    n_path = 0
    for sha in order:
        for path in sorted(paths[sha]):
            units += 1
            n_path += 1
            # the label is a hash: a path that matched may itself be the private value
            f = scan_text("path #%d (sha256 %s)" % (n_path, hashlib.sha256(path.encode()).hexdigest()[:12]), path, pats)
            if f:
                flagged_paths.add(path)
            findings += f
    meta = git(repo, "cat-file", "--batch-check", data=("\n".join(order) + "\n").encode()) if order else b""
    blobs = [l.split()[0] for l in meta.decode().splitlines() if len(l.split()) == 3 and l.split()[1] == "blob"]
    if blobs:
        out = git(repo, "cat-file", "--batch", data=("\n".join(blobs) + "\n").encode())
        pos = 0
        for sha in blobs:
            nl = out.index(b"\n", pos)
            size = int(out[pos:nl].split()[2])
            data = out[nl + 1:nl + 1 + size]
            pos = nl + 1 + size + 1
            units += 1
            if b"\0" in data:
                binaries += 1
            text = data.decode("latin-1")
            only_patterns_file = paths[sha] == {PATTERN_FILE}
            if paths[sha] & flagged_paths or not paths[sha]:
                label = "blob %s" % sha[:12]
            else:
                label = "blob %s (%s)" % (sha[:12], ", ".join(sorted(paths[sha])))
            findings += scan_text(label, text, pats, generic=not only_patterns_file)
    try:
        log = git(repo, "log", "--all", "--format=%H|%an|%ae|%cn|%ce|%s|%b%x00").decode("utf-8", "replace")
    except subprocess.CalledProcessError:
        log = ""
    for rec in log.split("\0"):
        rec = rec.strip("\n")
        if not rec:
            continue
        units += 1
        findings += scan_text("commit " + rec[:12], rec, pats)
    # dates: every author and committer date, and every annotated tag date, must be UTC (+0000)
    skipped = 0
    for rec in git(repo, "log", "--all", "--format=%H|%ai|%ci|%ce").decode().splitlines():
        sha, ad, cd, ce = rec.split("|")
        if ce == "noreply@github.com":
            # GitHub's own commits (test merges, web merges) carry the offset of whoever
            # triggered them; exempt by the committer being GitHub, never by the author
            skipped += 1
            continue
        for what, d in (("author date", ad), ("committer date", cd)):
            units += 1
            if not d.endswith(" +0000"):
                findings.append(("commit %s %s" % (sha[:12], what), "non-utc-date", 1))
    for rec in git(repo, "for-each-ref", "--format=%(refname)|%(taggerdate:iso)").decode().splitlines():
        ref, _, d = rec.partition("|")
        if d and not d.endswith(" +0000"):
            findings.append(("tag date of a ref", "non-utc-date", 1))
    refs = git(repo, "for-each-ref", "--format=%(refname)%0a%(taggername)%0a%(taggeremail)%0a%(contents)%00").decode("utf-8", "replace")
    for i, rec in enumerate(refs.split("\0")):
        if rec.strip():
            units += 1
            findings += scan_text("ref #%d" % i, rec, pats)
    return findings, units, binaries, skipped


def main():
    try:
        _main()
    except subprocess.CalledProcessError:
        print("hygiene: cannot read git data (not a git repository?)")
        sys.exit(2)


def _main():
    args = sys.argv[1:]
    pats, n_extra = load_patterns()
    binaries = skipped = 0
    if args == ["--stdin"]:
        findings = scan_text("stdin", sys.stdin.read(), pats)
        units = 1
    else:
        repo = os.getcwd()
        if args[:1] == ["--repo"] and len(args) == 2:
            repo = args[1]
        elif args:
            print(__doc__)
            sys.exit(2)
        findings, units, binaries, skipped = scan_repo(repo, pats)
    print("hygiene: scanned %d unit(s) (%d binary blob(s) included) with %d generic pattern(s) + email rule + %d private pattern(s)"
          % (units, binaries, len(pats) - n_extra, n_extra))
    print("hygiene: date rule skipped %d GitHub-made commit(s) (committer noreply@github.com)" % skipped)
    if findings:
        for label, name, c in findings:
            print("hygiene: FAIL: %s: %d match(es) of %s" % (label, c, name))
        print("hygiene: %d finding(s)" % len(findings))
        sys.exit(1)
    print("hygiene: clean (0 findings)")


if __name__ == "__main__":
    main()
