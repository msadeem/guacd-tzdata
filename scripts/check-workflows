#!/usr/bin/env python3
"""check-workflows -- static policy checks on the workflows, Dockerfile and BASE.

  scripts/check-workflows [repo-root]

Every failure prints one "static check: ..." line and the exit status is 1.
tests/guacd-image-gate-test.sh runs this on the real tree and on mutated copies
(each mutation must fail with its own message).
"""
import glob
import os
import re
import sys

root = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else os.path.abspath(
    os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
errors = []


def err(msg):
    errors.append("static check: " + msg)


def read(rel):
    try:
        return open(os.path.join(root, rel)).read()
    except OSError:
        err("%s is missing" % rel)
        return ""


def block(lines, header_re, indent):
    """Lines (stripped) of the mapping that follows the first line matching header_re at `indent`."""
    out, inside = [], False
    for ln in lines:
        if not inside:
            if re.match(r"^ {%d}%s\s*$" % (indent, header_re), ln):
                inside = True
            continue
        if ln.strip() == "" or ln.strip().startswith("#"):
            continue
        cur = len(ln) - len(ln.lstrip(" "))
        if cur <= indent:
            break
        out.append(ln)
    return out


def jobs_of(lines):
    """{job name: [lines]} for the jobs under the top-level `jobs:` key (jobs are keys at indent 2)."""
    out, cur = {}, None
    for ln in block(lines, r"jobs:", 0):
        m = re.match(r"^ {2}([A-Za-z0-9_-]+):\s*$", ln)
        if m:
            cur = m.group(1)
            out[cur] = []
        elif cur is not None:
            out[cur].append(ln)
    return out


KNOWN_WORKFLOWS = {"ci.yml", "publish.yml"}
wfdir = os.path.join(root, ".github/workflows")
for extra in sorted(set(os.listdir(wfdir) if os.path.isdir(wfdir) else []) - KNOWN_WORKFLOWS):
    err("unexpected file .github/workflows/%s (only ci.yml and publish.yml are allowed, so every rule sees every workflow)" % extra)
wfs = sorted(glob.glob(os.path.join(wfdir, "*.yml")))
if not wfs:
    err("no workflow files found")
for wf in wfs:
    rel = os.path.relpath(wf, root)
    text = open(wf).read()
    lines = text.splitlines()
    for i, ln in enumerate(lines, 1):
        m = re.match(r"^\s*-?\s*uses:\s*(\S+)", ln)
        if m:
            ref = m.group(1)
            if not re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+@[0-9a-f]{40}$", ref):
                err("%s:%d: 'uses: %s' is not pinned by a full 40-hex commit SHA" % (rel, i, ref))
    for i, ln in enumerate(lines, 1):
        if re.match(r"^\s*-?\s*uses:\s*docker/setup-buildx-action@", ln):
            nxt = [l.strip() for l in lines[i:i + 3]]
            if "driver: docker" not in nxt:
                err("%s:%d: docker/setup-buildx-action must set 'driver: docker' (no moving-tag builder image)" % (rel, i))
    if re.search(r"\bpull_request_target\b", text):
        err("%s uses pull_request_target" % rel)
    for t in ("schedule", "workflow_call"):
        if re.search(r"^\s{0,2}%s\s*:" % t, text, re.M):
            err("%s uses the %s trigger" % (rel, t))
    if re.search(r"\bsecrets\b", text):
        err("%s references secrets (only the automatic github.token may be used)" % rel)
    if not re.search(r"^defaults:\n  run:\n    shell: bash$", text, re.M):
        err("%s lacks top-level 'defaults: run: shell: bash' (pipefail)" % rel)
    top = [l.strip() for l in block(lines, r"permissions:", 0)]
    if top != ["contents: read"]:
        err("%s top-level permissions must be exactly 'contents: read', found %s" % (rel, top))

ci = read(".github/workflows/ci.yml")
if ci:
    cl = ci.splitlines()
    ctrig = [l.strip() for l in block(cl, r"on:", 0)]
    if ctrig != ["pull_request:", "push:", "branches: [main]"]:
        err("ci.yml triggers must be exactly pull_request and push on main, found %s" % ctrig)
    if re.search(r"^ {4}permissions:", ci, re.M):
        err("ci.yml has a job-level permissions block (jobs must inherit contents: read)")

pub = read(".github/workflows/publish.yml")
if pub:
    lines = pub.splitlines()
    trig = [l.strip() for l in block(lines, r"on:", 0)]
    if trig != ["workflow_dispatch:"]:
        err("publish.yml triggers must be exactly workflow_dispatch, found %s" % trig)
    jobs = jobs_of(lines)
    if sorted(jobs) != ["publish", "scan"]:
        err("publish.yml jobs must be exactly publish and scan, found %s" % sorted(jobs))
    want = sorted(["contents: read", "packages: write", "id-token: write", "attestations: write"])
    for name, wantset in (("publish", want), ("scan", sorted(["contents: read", "packages: read"]))):
        jl = jobs.get(name, [])
        got = sorted(l.strip() for l in block(jl, r"permissions:", 4))
        if got != wantset:
            err("publish.yml job %s permissions must be exactly %s, found %s" % (name, wantset, got))
        if sum(1 for l in jl if re.match(r"^ {4}permissions:", l)) != 1:
            err("publish.yml job %s must have exactly one permissions block" % name)
    scan = "\n".join(jobs.get("scan", []))
    if not re.search(r"^ {4}continue-on-error: true$", scan, re.M) or not re.search(r"^ {4}needs: publish$", scan, re.M):
        err("publish.yml scan job must be 'needs: publish' with continue-on-error: true")
    if "id-token" in scan or "actions/attest" in scan:
        err("publish.yml scan job must not hold id-token or attest")
    if "artifact-metadata" in pub:
        err("publish.yml mentions artifact-metadata (it must be absent)")
    if "if: github.ref == 'refs/heads/main'" not in pub:
        err("publish.yml job has no main-only condition")
    if 'GITHUB_REF" != "refs/heads/main"' not in pub:
        err("publish.yml has no refuse-anything-but-main guard step")
    if not re.search(r"^\s*concurrency:", pub, re.M):
        err("publish.yml has no concurrency group")
    if pub.count("persist-credentials: false") != pub.count("actions/checkout@"):
        err("publish.yml checkout lacks persist-credentials: false")
    # step order inside the publish job: no credential before the gate, push bound to the gate
    pl = jobs.get("publish", [])
    names = [m.group(1) for l in pl for m in [re.match(r"^\s{6}- name: (.*)$", l)] if m]
    order = ["Build", "Gate", "Log in", "Refuse a re-publish", "Push", "Attest", "Summary"]
    pos = []
    for o in order:
        hit = [i for i, n in enumerate(names) if n.startswith(o)]
        if len(hit) != 1:
            err("publish.yml publish job must have exactly one step named '%s...'" % o)
        else:
            pos.append(hit[0])
    if len(pos) == len(order) and pos != sorted(pos):
        err("publish.yml publish job steps are out of order (build, gate, login, re-publish check, push, attest, summary)")
    ptext = "\n".join(pl)
    if "GATED_CONFIG_DIGEST_FILE" not in ptext or ptext.count("GATED_CONFIG_DIGEST_FILE") < 2:
        err("publish.yml gate and push steps must share GATED_CONFIG_DIGEST_FILE")
    if '"$pushed_config" != "$gated_config"' not in ptext:
        err("publish.yml push step does not compare the pushed config digest with the gated one")
    if "already published" not in ptext:
        err("publish.yml has no refusal for an already published sha-<commit> tag")
    if "image.manifest*" in ptext or "application/vnd.oci.image.manifest.v1+json" not in ptext \
            or "application/vnd.docker.distribution.manifest.v2+json" not in ptext:
        err("publish.yml must accept exactly the OCI and Docker v2 single-manifest media types")
    # the attest step and its inputs
    idx = [i for i, l in enumerate(lines) if re.match(r"^\s*-?\s*uses:\s*actions/attest@", l)]
    if len(idx) != 1:
        err("publish.yml must have exactly one actions/attest step, found %d" % len(idx))
    else:
        i = idx[0]
        step = []
        for l in lines[i + 1:]:
            if re.match(r"^\s{6}- ", l) or re.match(r"^  [a-z]", l):
                break
            step.append(l.strip())
        for need in ("push-to-registry: true", "create-storage-record: false", "show-summary: false"):
            if need not in step:
                err("the actions/attest step lacks %s" % need)

base = read("BASE").strip()
if not re.match(r"^guacamole/guacd@sha256:[0-9a-f]{64}$", base):
    err("BASE is not a guacamole/guacd@sha256:<64 hex> reference")
for rel in [os.path.relpath(w, root) for w in wfs] + ["scripts/build-guacd-image"]:
    if re.search(r"sha256:[0-9a-f]{64}", read(rel)):
        err("%s carries a literal digest; BASE is the only home" % rel)
if 'BASE' not in read("scripts/build-guacd-image") or '"$ROOT/BASE"' not in read("scripts/build-guacd-image"):
    err("scripts/build-guacd-image does not read the BASE file")
if '$(cat BASE)' not in pub:
    err("publish.yml does not read the BASE file")

df = read("Dockerfile")
if df:
    cont = False
    for ln in df.splitlines():
        stripped = ln.strip()
        if cont or not stripped or stripped.startswith("#"):
            cont = ln.rstrip().endswith("\\") and bool(stripped) and not stripped.startswith("#") or (cont and ln.rstrip().endswith("\\"))
            continue
        if not re.match(r"^[A-Z]+(\s|$)", ln):
            err("Dockerfile instructions must be upper-case at column 0: %s" % stripped[:40])
        cont = ln.rstrip().endswith("\\")
    if re.search(r"^\s*ARG\s+BASE=", df, re.M | re.I):
        err("Dockerfile gives ARG BASE a default")
    if re.search(r"^\s*ENV\b.*\bTZ\b", df, re.M | re.I):
        err("Dockerfile sets a TZ environment variable")
    if not re.search(r"^\s*FROM\s+\$\{BASE\}\s*$", df, re.M | re.I):
        err("Dockerfile has no plain 'FROM ${BASE}' final stage")
    labels = re.findall(r"^\s*LABEL\s+((?:.*\\\n)*.*)$", df, re.M | re.I)
    if not labels:
        err("Dockerfile has no LABEL instruction")
    else:
        body = " ".join(x.replace("\\\n", " ") for x in labels)
        toks = re.findall(r'(\S+?)=("[^"]*"|\S*)', body)
        rest = re.sub(r'(\S+?)=("[^"]*"|\S*)', "", body).strip()
        if rest:
            err("Dockerfile LABEL has text that is not key=\"value\": %s" % rest)
        for k, v in toks:
            if not (len(v) >= 2 and v[0] == '"' and v[-1] == '"'):
                err("label %s must be key=\"value\" (quoted)" % k)
        pairs = [(k, v.strip('"')) for k, v in toks]
        keys = sorted(k for k, _ in pairs)
        wantk = sorted([
            "org.opencontainers.image.source", "org.opencontainers.image.revision",
            "org.opencontainers.image.created", "org.opencontainers.image.base.name",
            "org.opencontainers.image.base.digest", "guacd-tzdata.tzdata-version",
            "guacd-tzdata.workflow-run-id"])
        if keys != wantk:
            err("Dockerfile label keys must be exactly %s, found %s" % (wantk, keys))
        for k, v in pairs:
            literal = re.sub(r"\$\{[A-Z_]+\}", "", v)
            if "$" in literal:
                err("label %s is neither a literal nor a plain build arg" % k)
        src = dict(pairs).get("org.opencontainers.image.source", "")
        if not re.match(r"^https://github\.com/[A-Za-z0-9-]+/guacd-tzdata$", src):
            err("label org.opencontainers.image.source is not the public repo URL")
    last_user = re.findall(r"^\s*USER\s+(\S+)", df, re.M | re.I)
    if not last_user or last_user[-1] != "guacd":
        err("Dockerfile does not end as USER guacd")

if errors:
    print("\n".join(errors))
    print("static check: %d failure(s)" % len(errors))
    sys.exit(1)
print("ok: static checks (pins, triggers, permissions, attest inputs, BASE, labels)")
